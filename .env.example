# Frontend API base. Leave unset in dev to use Vite proxy (/api → http://127.0.0.1:8000).
# For production or custom ports:
# VITE_API_URL=http://127.0.0.1:8000

# Google sign-in on login/signup. Set to false to disable the Google button (email / phone / passkey only).
# VITE_ENABLE_GOOGLE_SIGNIN=false

# Google Identity Services OAuth client ID (Web application). Ignored when VITE_ENABLE_GOOGLE_SIGNIN=false.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Phone login: default national prefix when users omit +country (defaults to 91 — India). Use `none` to disable.
# VITE_PHONE_DEFAULT_COUNTRY_CODE=91

