# Frontend API base. Leave unset in dev to use Vite proxy (/api → http://127.0.0.1:8000).
# For production or custom ports:
# VITE_API_URL=http://127.0.0.1:8000

# Google Identity Services client ID (only needed if you want the Google
# sign-in button on the login/signup screens). Leave unset to hide it.
# VITE_GOOGLE_CLIENT_ID=

