# Secrets — never commit
.env
.env.local
.env.*.local
backend/.env
!.env.example
!backend/.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
backend/.venv/

# Local SQLite (dev)
backend/*.db

# Node / Vite
node_modules/
dist/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Terraform (local applies — never commit state with secrets-derived metadata to public forks without review)
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
infra/terraform/terraform.tfvars
