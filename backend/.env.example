# Copy this file to .env (run ONLY this line — no extra words after it):
#   cp .env.example .env
#
# Then set DATABASE_URL to a database that actually exists on your machine.

# --- Option A: Docker Postgres (matches docker-compose.yml in this folder) ---
# Start DB:  docker compose up -d
# Prefer 127.0.0.1 over localhost on macOS (avoids IPv6 ::1 connection issues).
# DATABASE_URL=postgresql+psycopg2://holistica:holistica@127.0.0.1:5432/holistica_health

# --- Option B: Local Postgres with your macOS username (common Homebrew install) ---
# Replace YOUR_USER with the output of: whoami
# Create DB once:  createdb holistica_health
# DATABASE_URL=postgresql+psycopg2://YOUR_USER@localhost:5432/holistica_health

# --- Option C: Default superuser "postgres" with password ---
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/holistica_health

# --- Option D: Homebrew Postgres when Docker Desktop is not running ---
# Homebrew `pgvector` supports PostgreSQL 17+ only. Example (port 5432):
#   brew install postgresql@17 pgvector && brew services start postgresql@17
# One-time (connects as your macOS user = superuser):
#   psql -d postgres -c "CREATE ROLE holistica WITH LOGIN PASSWORD 'holistica';" \
#     -c "CREATE DATABASE holistica_health OWNER holistica;"
#   psql -d holistica_health -c "CREATE EXTENSION vector;"
# Then:  cd backend && source .venv/bin/activate && alembic upgrade head

# Active URL (pick one pattern above and uncomment, or paste your own).
# If you see "PostgreSQL is not reachable": start Docker Desktop, then from backend/: docker compose up -d && alembic upgrade head
DATABASE_URL=postgresql+psycopg2://holistica:holistica@127.0.0.1:5432/holistica_health

# Comma-separated browser origins allowed to call the API (exact scheme + host, no path).
# Local dev:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (atharvayur.ai on EC2) — MUST include every origin users open in the browser:
# CORS_ORIGINS=https://www.atharvayur.ai,https://atharvayur.ai,https://d36wqev5uzuq6j.cloudfront.net,http://localhost:5173

# OpenWeatherMap — current weather for environment tips + chat context (free tier API key)
OPENWEATHER_API_KEY=

# LLM provider — "gemini" or "groq". If this key is missing, the app defaults
# to gemini and needs GEMINI_API_KEY (a frequent cause of "GEMINI_API_KEY is not set").
# Groq: no embeddings / Google grounding vs Gemini — see docs.
LLM_PROVIDER=groq

# Gemini (Step 3) — required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional override (default in app/config.py is gemini-2.5-flash)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq — required when LLM_PROVIDER=groq. Free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# IMMEDIATE_HISTORY_LIMIT=3
# SEMANTIC_HISTORY_LIMIT=5

# Google sign-in — must be the same OAuth 2.0 *Web application* client ID as
# VITE_GOOGLE_CLIENT_ID in the frontend .env (used to verify the ID token).
# GOOGLE_CLIENT_ID=

# JWT auth
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
